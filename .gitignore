# Local golden-build payloads are preserved outside Git.  Only their request,
# semantic baseline, metrics and hashes are versioned.
reference/**/artifacts/

# Terraform keeps state and operator-specific values local.  CI uses OIDC and
# never consumes a committed credential or long-lived AWS key.
infra/**/.terraform/
infra/**/*.tfplan
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/*.tfvars
!infra/**/*.tfvars.example
infra/**/plans/

