ARG BASE_IMAGE=fireviewer-map-builder:frozen-v1-20260821
FROM ${BASE_IMAGE}

ARG BUILDER_GIT_COMMIT=766f157d00e15da72271ec197706c203f040fb7a
ARG BUILDER_CONTRACT_VERSION=fireviewer.map-job.v1
ARG AWS_CLI_VERSION=2.36.28

LABEL org.opencontainers.image.title="FireViewer Map Builder" \
      org.opencontainers.image.revision="${BUILDER_GIT_COMMIT}" \
      fireviewer.builder.contract="${BUILDER_CONTRACT_VERSION}" \
      fireviewer.builder.reference="map-builder-reference-v1"

# The runtime directory is provider-neutral. The AWS execution adapter is kept
# in a separate path and is invoked only by the Batch job definition.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl unzip \
    && curl --fail --silent --show-error --location \
      "https://awscli.amazonaws.com/awscli-exe-linux-x86_64-${AWS_CLI_VERSION}.zip" \
      --output /tmp/awscliv2.zip \
    && unzip -q /tmp/awscliv2.zip -d /tmp \
    && if command -v aws >/dev/null 2>&1; then /tmp/aws/install --update; else /tmp/aws/install; fi \
    && rm -rf /tmp/aws /tmp/awscliv2.zip /var/lib/apt/lists/*

COPY runtime/ /opt/fireviewer/runtime/
COPY blender/build_tiled_viewer_package.py \
    blender/build_tiled_viewer_from_sealed.py \
    blender/export_tiled_viewer_prototypes.py \
    blender/map_validation_folder.py \
    blender/map_validation_job.py \
    blender/simple_production_engine.py \
    /opt/fireviewer/fireviewer-spatial/blender/
COPY infra/aws-map-builder/scripts/execute-batch.sh /opt/fireviewer/aws/execute-batch.sh
COPY infra/aws-map-builder/scripts/execute-batch-shard.sh /opt/fireviewer/aws/execute-batch-shard.sh
COPY infra/aws-map-builder/scripts/execute-hf-export.sh /opt/fireviewer/aws/execute-hf-export.sh
COPY deploy/aws-map-builder-entrypoint.sh /usr/local/bin/aws-map-builder-entrypoint
RUN chmod 0555 /opt/fireviewer/runtime/map_builder.py \
    /opt/fireviewer/aws/execute-batch.sh \
    /opt/fireviewer/aws/execute-batch-shard.sh \
    /opt/fireviewer/aws/execute-hf-export.sh \
    /opt/fireviewer/runtime/hf_viewer_exporter.py \
    /usr/local/bin/aws-map-builder-entrypoint \
    && ln -sfn /opt/fireviewer/runtime/map_builder.py /usr/local/bin/map-builder

ENV PYTHONPATH=/opt/fireviewer/runtime:/opt/fireviewer/fireviewer-spatial/blender:/opt/fireviewer/fireviewer-spatial/omniverse \
    FIREVIEWER_VALIDATION_REQUEST_JSON="" \
    FIREVIEWER_VALIDATION_REQUEST_FILE="" \
    FIREVIEWER_VALIDATION_CREATE_EVIDENCE=0 \
    FIREVIEWER_VALIDATION_REQUIRE_EVIDENCE_UPLOAD=0 \
    FIREVIEWER_VALIDATION_PUBLISH_VIEWER=0 \
    FIREVIEWER_VALIDATION_REQUIRE_VIEWER_PUBLICATION=0 \
    FIREVIEWER_VALIDATION_MONOLITHIC_VIEWER=off \
    FIREVIEWER_VALIDATION_REQUIRE_NINE_TILES=0

HEALTHCHECK NONE
ENTRYPOINT ["/usr/local/bin/aws-map-builder-entrypoint"]
CMD ["--request", "/input/request.json", "--scratch-root", "/scratch", "--output", "/output"]
