{
  "schema": "fireviewer.terrain-streaming-contract.v2",
  "coordinate_system": {
    "horizontal_crs": "EPSG:2154",
    "vertical_datum": "NGF-IGN69",
    "linear_unit": "metre",
    "up_axis": "Z"
  },
  "tile": {
    "size_m": 500.0,
    "bounds": "three_dimensional_aabb_from_lod2_vertical_extrema",
    "stitch_mask_bits": {"west": 1, "east": 2, "south": 4, "north": 8},
    "stitch_mask_count": 16,
    "stitch_rule": "bit_on_finer_tile_when_edge_neighbour_is_exactly_one_lod_coarser",
    "maximum_adjacent_lod_delta": 1,
    "catalog_triangle_costs": "resource_costs.lodN.stitch_triangle_counts_indexed_by_mask",
    "gpu_stitch_cost": "mask0_gpu_bytes_plus_12_bytes_per_triangle_delta"
  },
  "selection": {
    "algorithm": "exact_convex_sat_aabb_frustum",
    "near_and_far_planes_required": true,
    "tangent_contact_intersects": true,
    "radial_selection_permitted": false,
    "fixed_tile_count_cap_permitted": false
  },
  "residency": {
    "visible_lod0": "all_tile_aabbs_intersecting_the_active_camera_envelope",
    "guard_lod0_ring_count": 1,
    "guard_scope": "union_of_active_and_staging_frustum_tiles",
    "guard_publication_gate": "complete_before_camera_publication",
    "staging_lod0": "all_tile_aabbs_intersecting_the_next_or_predicted_camera_envelope",
    "lod1_additional_ring_count": 2,
    "resident_lod2": "all_remaining_zone_tiles",
    "neighbourhood": "chebyshev_on_the_lambert93_500m_grid",
    "camera_envelope_zoom_policy": "union_all_declared_views_including_widest_zoom"
  },
  "transition": {
    "buffering": "active_plus_staging",
    "publication": "atomic_after_complete_staging_visible_lod0_residency",
    "visible_lower_lod_fallback": "forbidden",
    "maximum_load_failure_count": 3,
    "load_failure_policy": "retry_then_quarantine_for_current_generation",
    "quarantine_retry_api": "explicit_new_generation",
    "payload_integrity_gate": "catalog_build_id_and_sha256_must_match_observed_load",
    "stitch_handshake": "payload_ref_includes_validated_four_bit_mask",
    "hysteresis_seconds": 3.0,
    "old_active_lod0_policy": "retain_then_demote_after_replacement_payload_is_resident",
    "action_acknowledgement_required": true
  },
  "interactive_prediction": {
    "horizon_seconds": 2.0,
    "sample_interval_seconds": 0.25,
    "teleport_or_fast_rotation_policy": "keep_previous_camera_published_until_new_lod0_is_complete"
  },
  "budget": {
    "memory_reserve_fraction": 0.25,
    "memory_reserve_policy": "minimum_not_overridable_below_contract",
    "included_roles": [
      "active_lod0",
      "staging_lod0",
      "guard_lod0",
      "lod1",
      "lod2"
    ],
    "overlap_accounting": "unique_payload_once",
    "failure_policy": "reject_camera_plan_before_loading",
    "silent_far_clip_or_lod_downgrade_permitted": false
  },
  "camera_envelope": {
    "schema": "fireviewer.camera-envelope.v1",
    "required_fields": [
      "camera_id",
      "mode",
      "views"
    ],
    "view_required_fields": [
      "view_id",
      "position_l93_ngf_m",
      "forward",
      "up",
      "vertical_fov_deg",
      "aspect_ratio",
      "near_clip_m",
      "far_clip_m"
    ]
  },
  "camera_residency_plan": {
    "schema": "fireviewer.camera-residency-plan.v1",
    "planned_camera_policy": "active_entry_preloads_the_next_camera_envelope",
    "camera_binding": "canonical_camera_envelope_and_sha256_recomputed_before_acceptance",
    "frustum_binding": "all_residency_sets_recomputed_from_bound_envelopes",
    "terrain_aov": "fireviewer:terrain_lod",
    "main_camera_allowed_aov_value": 0
  },
  "resume": {
    "state_restore": "complete_fail_closed_revalidation_against_catalog_and_budget",
    "restored_fields": "cameras_generation_sequence_failures_quarantine_backoff_retention_pending_action_policy_budget_telemetry",
    "restored_resident_payloads_budgeted_before_loading": true,
    "obsolete_payloads_evicted_before_new_loads": true,
    "pending_publication_revalidated_before_commit": true,
    "commit_preconditions_are_transactional": true,
    "lower_lod_on_visible_tile_permitted": false
  }
}
