#usda 1.0
(
    defaultPrim = "Procedural"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Procedural"
{
    custom string fireviewer:fallback = "measured-tree-conifer"
    def Cylinder "Trunk"
    {
        uniform token axis = "Y"
        double height = 0.35
        double radius = 0.06
        color3f[] primvars:displayColor = [(0.28, 0.16, 0.08)]
        double3 xformOp:translate = (0, 0.175, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cone "Crown"
    {
        uniform token axis = "Y"
        double height = 0.8
        double radius = 0.5
        color3f[] primvars:displayColor = [(0.08, 0.30, 0.10)]
        double3 xformOp:translate = (0, 0.6, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
