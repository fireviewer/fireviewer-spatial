#usda 1.0
(
    defaultPrim = "Procedural"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Procedural"
{
    custom string fireviewer:fallback = "measured-tree-broadleaf"
    def Cylinder "Trunk"
    {
        uniform token axis = "Y"
        double height = 0.5
        double radius = 0.07
        color3f[] primvars:displayColor = [(0.28, 0.16, 0.08)]
        double3 xformOp:translate = (0, 0.25, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "Crown"
    {
        double radius = 0.5
        color3f[] primvars:displayColor = [(0.16, 0.42, 0.12)]
        double3 xformOp:scale = (1, 0.55, 1)
        double3 xformOp:translate = (0, 0.72, 0)
        uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:translate"]
    }
}
