#usda 1.0
(
    defaultPrim = "Procedural"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Procedural"
{
    custom string fireviewer:fallback = "measured-building-box"
    def Cube "Body"
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.62, 0.58, 0.52)]
        double3 xformOp:translate = (0, 0.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
