{
  "schema": "fireviewer.mns-mnt-placement-contract.v2",
  "status": "experimental_r12_resilient_placement_candidate",
  "compatibility_inventory_schema": "fireviewer.mns-mnt-placement-inventory.v1",
  "algorithm": "fireviewer.mns-mnt-placement-algorithm.v10",
  "crs": "EPSG:2154",
  "grid": {
    "canonical_hag_resolution_m": 1,
    "native_elevation_resolution_m": 0.5,
    "processing_halo_m": 10,
    "tile_size_m": 500,
    "ownership": "half_open"
  },
  "canonical_hag_source_quality": {
    "sparse_positive_uint16_outlier_policy": "replace at most 32 samples and fraction at most 0.000125 above 65534cm with local MNT ground and record diagnostics",
    "larger_positive_outlier_population": "reject_as_corrupt_or_misaligned",
    "candidate_authority_after_repair": "all_non_outlier_measured_hag_samples",
    "negative_hag_policy": "clamp_negative_to_ground_when_fraction_below_minus_100cm_is_at_most_1pct",
    "systemic_negative_offset": "reject_when_more_than_1pct_of_canonical_samples_are_below_mnt_by_more_than_100cm"
  },
  "buildings": {
    "existence_authority": "stable_bdtopo_footprint_confirmed_by_measured_mns_minus_mnt",
    "xy_geometry_authority": "bdtopo_footprint",
    "ground_authority": "mnt",
    "height_authority": "mns_minus_mnt_p95_inside_footprint",
    "minimum_measured_height_m": 2,
    "morphology_only_buildings": "never_instantiated",
    "representation": "real_reviewed_catalog_usd_asset_else_measured_procedural_fallback",
    "procedural_building_asset": "allowed_only_as_measured_candidate_fallback_when_catalog_asset_is_invalid_or_visual_role_budget_is_exceeded",
    "primitive_placeholder": "forbidden",
    "asset_selection": "strict_source_semantics_then_height_footprint_class_then_closest_uniform_scale_shape",
    "asset_scale": "one_uniform_factor_only_no_axis_stretching",
    "generic_building_semantics": "residential_only_special_assets_require_explicit_source_evidence",
    "residential_form_rules": {
      "multi_storey_residential": "height_m >= 13 or (height_m >= 10 and footprint_area_m2 >= 250)",
      "mid_rise_residential": "otherwise height_m >= 8 or footprint_area_m2 >= 180",
      "low_rise_house": "otherwise",
      "explicit_special_semantics": "source evidence overrides residential form filtering"
    },
    "adjacency": "shared_footprint_boundaries_may_touch_but_positive_area_intersections_remove_the_lower_priority_candidate",
    "asset_may_change_measured_position": false
  },
  "trees": {
    "quantity_authority": "measured_hag_crown_candidates_without_quota_or_thinning",
    "candidate_generation": "legacy_1m_peak_preserving_hag_watershed",
    "native_refinement": "same_1m_peak_cell_selects_highest_native_0.5m_hag_sample",
    "native_refinement_integrity_failure": "reject_tile_when_more_than_1pct_of_native_samples_are_below_mnt_by_more_than_100cm",
    "native_refinement_may_change_candidate_count": false,
    "native_refinement_may_cross_1m_peak_cell": false,
    "ground_authority": "native_0.5m_mnt_when_available_else_1m_mnt",
    "visual_base_authority": "highest_native_mnt_sample_inside_original_1m_peak_cell_bounded_to_15cm_clearance_above_selected_ground",
    "height_authority": "native_0.5m_mns_minus_mnt_when_available_else_1m_hag",
    "horizontal_extent_authority": "measured_equivalent_crown_diameter",
    "asset_scale": "one_uniform_factor_fitted_inside_measured_crown_and_height_bounds",
    "asset_semantics": "current_bdtopo_forest_composition_else_bdforet_v1_composition_then_conifer_or_oak_only",
    "allowed_runtime_forms": [
      "conifer",
      "oak"
    ],
    "representation": "real_reviewed_catalog_usd_asset_else_measured_procedural_fallback",
    "procedural_tree_asset": "allowed_only_as_measured_candidate_fallback_when_catalog_asset_is_invalid",
    "primitive_placeholder": "forbidden",
    "viewer_thinning": "forbidden",
    "viewer_quota": "forbidden",
    "count_semantics": "estimated_individual_crowns_not_certified_tree_stems"
  },
  "context_assets": {
    "meaning": "discrete_real_world_objects_such_as_barriers_signals_boxes_furniture_or_other_catalogued_equipment",
    "automatic_asset_from_road_rail_or_hydro_feature": "forbidden",
    "fixed_validated_user_coordinate": "allowed",
    "future_explicit_equipment_source": "allowed_when_source_identity_and_geometry_are_recorded",
    "representation": "real_reviewed_catalog_usd_asset_only",
    "procedural_equipment_asset": "forbidden",
    "primitive_placeholder": "forbidden"
  },
  "infrastructure": {
    "roads": "measured_or_sig_surface_geometry_not_a_discrete_equipment_asset",
    "rail": "measured_or_sig_linear_surface_geometry_not_a_discrete_equipment_asset",
    "hydro": "measured_or_sig_surface_or_line_geometry_not_a_discrete_equipment_asset",
    "rule": "procedural_geometry_is_allowed_only_for_continuous_geographic_surfaces_or_lines_never_for_discrete_objects"
  },
  "viewer": {
    "role": "complete_non_simplified_map_representation",
    "publication_root": "maps/<zone_id>/<build_id>/runtime",
    "quantity_authority": "none",
    "mesh_coverage": "complete",
    "completeness_policy": "fail_closed_exact_visual_scene",
    "missing_canonical_instance_count": "zero_except_candidates_explicitly_removed_with_reason_by_placement_policy",
    "extra_canonical_instance_count": 0,
    "placeholder_instance_count": 0,
    "simplified_primary_viewer": "forbidden",
    "lod_may_remove_logical_objects": false,
    "compression_may_change_logical_objects": false
  },
  "validation_publication": {
    "format": "folder_native",
    "zip": "forbidden",
    "role": "evidence_only_not_a_map",
    "root": "validation/<zone_id>/<build_id>/<provider>"
  },
  "provider_transition": {
    "lightning_r46": "untouched_comparison_reference",
    "runpod_v2": "replacement_candidate_until_9_tile_quality_validation_passes"
  }
}
