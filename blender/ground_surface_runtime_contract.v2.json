  "composition": {
    "ground_blend": {
      "maximum_profiles_per_tile": 4,
      "weight_map": "ground-material-map.png",
      "weight_channels": ["r", "g", "b", "a"],
      "weight_normalization": "sum_to_one_per_pixel"
    },
    "directional_area": {
      "geometry_source": "approved_land_parcels",
      "orientation_source": "parcel_dominant_axis_or_declared_crop_axis"
    },
    "linear_overlay": {
      "geometry_source": "approved_transport_network",
      "uv_origin": "network_curvilinear_abscissa",
      "variant_segment_length_m": 250.0,
      "anti_repetition": "exclude_previous_two_variants_on_same_network",
      "cross_tile_continuity": "required"
    },
    "watercourse_overlay": {
      "geometry_source": "approved_hydrography",
      "uv_origin": "downstream_curvilinear_abscissa",
      "bank_policy": "derive_left_right_banks_from_width_and_flow_direction",
      "water_policy": "procedural_shader_separate_from_contextual_bed",
      "variant_segment_length_m": 250.0,
      "cross_tile_continuity": "required"
    },
    "slope_cliff_overlay": {
      "geometry_source": "MNT_slope_aspect_and_approved_geology",
      "projection": "metric_triplanar",
      "minimum_slope_degrees": 38.0,
      "blend_band_degrees": 7.0
    },
    "rail_geometry": {
      "steel_rails": "required_separate_future_3d_geometry",
      "ground_scope": "ballast_sleepers_embankment_and_verge"
    }
  },
  "required_context_layers": [
    "approved_landcover_class",
    "approved_geological_parent_material",
    "approved_land_parcels",
    "approved_transport_network",
    "approved_hydrography",
    "incident_affected_area_or_burn_severity",
    "MNT_slope",
    "MNT_aspect",
    "MNT_roughness",
    "MNS_minus_MNT_object_reservation"
  ],
  "determinism": {
    "seed_inputs": ["fire_id", "feature_id", "tile_id", "catalog_sha256", "contract_sha256"],
    "silent_fallback": "forbidden"
  },
  "fail_closed_conditions": [
    "atlas_catalog_not_visually_accepted",
    "atlas_catalog_hash_mismatch",
    "runtime_contract_not_accepted",
    "runtime_texture_count_not_four",
    "direct_source_image_import_detected",
    "required_context_layer_missing",
    "profile_family_empty",
    "linear_network_width_or_class_missing",
    "cross_tile_uv_discontinuity",
    "directional_parcel_orientation_missing",
    "hydrographic_flow_direction_or_bank_side_ambiguous",
    "cliff_geology_missing",
    "railway_steel_rails_baked_into_ground_atlas"
  ]
}
