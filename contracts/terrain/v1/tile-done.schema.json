{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fireviewer.fr/contracts/terrain/v1/tile-done.schema.json",
  "title": "FireViewer adaptive terrain tile completion receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "tile_id", "recipe_id", "recipe_build_id", "normal_halo_sha256", "stitch_variants", "inputs", "ground_material", "outputs"],
  "properties": {
    "schema": {"const": "fireviewer.tile.done.v2"},
    "tile_id": {"type": "string", "minLength": 1},
    "recipe_id": {"$ref": "#/$defs/sha256"},
    "recipe_build_id": {"$ref": "#/$defs/sha256"},
    "normal_halo_sha256": {"$ref": "#/$defs/sha256"},
    "stitch_variants": {"$ref": "tile-package.schema.json#/$defs/stitchCatalog"},
    "inputs": {"$ref": "#/$defs/artifactMap"},
    "ground_material": {"$ref": "tile-package.schema.json#/$defs/groundMaterial"},
    "outputs": {"$ref": "#/$defs/canonicalOutputs"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byte_count", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
        },
        "byte_count": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifactMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/artifact"}
    },
    "canonicalOutputs": {
      "type": "object",
      "required": [
        "terrain_lod0",
        "terrain_lod1",
        "terrain_lod2",
        "hag_max_2m",
        "ground_profile_ids",
        "ground_profile_weights",
        "surface_overlays",
        "tile_composition",
        "tile_package"
      ],
      "additionalProperties": false,
      "properties": {
        "terrain_lod0": {"$ref": "#/$defs/artifact"},
        "terrain_lod1": {"$ref": "#/$defs/artifact"},
        "terrain_lod2": {"$ref": "#/$defs/artifact"},
        "hag_max_2m": {"$ref": "#/$defs/artifact"},
        "ground_profile_ids": {"$ref": "#/$defs/artifact"},
        "ground_profile_weights": {"$ref": "#/$defs/artifact"},
        "surface_overlays": {"$ref": "#/$defs/artifact"},
        "tile_composition": {"$ref": "#/$defs/artifact"},
        "tile_package": {"$ref": "#/$defs/artifact"}
      }
    }
  }
}
