{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fireviewer.fr/contracts/terrain/v1/ground-material-contract.schema.json",
  "title": "FireViewer shared ground material contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "material_model",
    "crs",
    "orthophoto_dependency",
    "atlas_catalog_status",
    "visual_acceptance",
    "atlas_catalog",
    "material_layer",
    "runtime_atlas",
    "profile_count",
    "profile_table",
    "composition",
    "qa_shader"
  ],
  "properties": {
    "schema": {"const": "fireviewer.ground-material-contract.v1"},
    "material_model": {"const": "FireViewerGroundSurface_v1"},
    "crs": {"const": "EPSG:2154"},
    "orthophoto_dependency": {"const": "forbidden"},
    "atlas_catalog_status": {"type": "string", "minLength": 1},
    "visual_acceptance": {"enum": ["pending_human_review", "accepted_human_visual"]},
    "atlas_catalog": {"$ref": "#/$defs/artifact"},
    "material_layer": {"$ref": "#/$defs/artifact"},
    "runtime_atlas": {
      "type": "object",
      "required": ["size_px", "grid_size", "cell_size_px", "gutter_px", "assets"],
      "additionalProperties": false,
      "properties": {
        "size_px": {"type": "integer", "minimum": 1},
        "grid_size": {"type": "integer", "minimum": 1},
        "cell_size_px": {"type": "integer", "minimum": 1},
        "gutter_px": {"type": "integer", "minimum": 0},
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["basecolor", "normal", "height", "orm"],
          "properties": {
            "basecolor": {"$ref": "#/$defs/pngArtifact"},
            "normal": {"$ref": "#/$defs/pngArtifact"},
            "height": {"$ref": "#/$defs/pngArtifact"},
            "orm": {"$ref": "#/$defs/pngArtifact"}
          }
        }
      }
    },
    "profile_count": {"const": 72},
    "profile_table": {
      "type": "array",
      "minItems": 72,
      "maxItems": 72,
      "items": {
        "type": "object",
        "required": ["index", "id", "surface_basis", "atlas_slot", "atlas_uv", "physical_scale_m", "parameters"],
        "additionalProperties": false,
        "properties": {
          "index": {"type": "integer", "minimum": 0, "maximum": 71},
          "id": {"type": "string", "minLength": 1},
          "surface_basis": {"type": "string"},
          "atlas_slot": {"type": ["integer", "null"]},
          "atlas_uv": {"type": ["object", "null"]},
          "physical_scale_m": {"type": "number", "exclusiveMinimum": 0},
          "parameters": {"type": "object"}
        }
      }
    },
    "composition": {"type": "object"},
    "qa_shader": {"type": "object"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "required": ["path", "byte_count", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "byte_count": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "pngArtifact": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {
          "type": "object",
          "required": ["width", "height", "bit_depth", "colour_type"],
          "properties": {
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1},
            "bit_depth": {"type": "integer"},
            "colour_type": {"type": "integer"}
          }
        }
      ]
    }
  }
}
