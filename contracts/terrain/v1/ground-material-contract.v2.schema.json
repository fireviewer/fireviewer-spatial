{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fireviewer.fr/contracts/terrain/v1/ground-material-contract.v2.schema.json",
  "title": "FireViewer clean PBR ground material contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "material_model", "crs", "orthophoto_dependency", "source_library", "visual_acceptance", "material_layer", "runtime_atlas", "profile_count", "profile_table", "composition", "qa_shader", "runtime_shader"],
  "properties": {
    "schema": {"const": "fireviewer.ground-material-contract.v2"},
    "material_model": {"const": "FireViewerGroundSurface_v2"},
    "crs": {"const": "EPSG:2154"},
    "orthophoto_dependency": {"const": "forbidden"},
    "source_library": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "manifest_sha256", "identity_sha256", "content_sha256", "texture_contract_sha256", "status"],
      "properties": {
        "schema": {"const": "fireviewer.clean-pbr-texture-library.v1"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "identity_sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "texture_contract_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["generated_pending_visual_review", "accepted_clean_pbr_library"]}
      }
    },
    "visual_acceptance": {"enum": ["pending_human_review", "accepted_human_visual"]},
    "material_layer": {"$ref": "#/$defs/artifact"},
    "runtime_atlas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_px", "height_px", "assets"],
      "properties": {
        "width_px": {"const": 8192},
        "height_px": {"const": 4096},
        "assets": {"$ref": "#/$defs/fourPngArtifacts"}
      }
    },
    "profile_count": {"const": 72},
    "profile_table": {
      "type": "array",
      "minItems": 72,
      "maxItems": 72,
      "items": {"$ref": "#/$defs/profile"}
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ids", "weights", "confidence", "orientation", "grid_size_px", "cell_size_m", "row_order", "world_projection", "variant_selection", "runtime_procedural_material", "runtime_orthophoto", "surface_overlays"],
      "properties": {
        "ids": {"const": "ground-profile-ids.png RGBA8 zero-based profile indices"},
        "weights": {"const": "ground-profile-weights.png RGBA8 sum exactly 255"},
        "confidence": {"const": "ground-confidence.png L8 matcher confidence 0..255"},
        "orientation": {"const": "ground-orientation.png L8 0..255 maps to 0..pi radians (undirected axis)"},
        "grid_size_px": {"const": [500, 500]},
        "cell_size_m": {"const": 1},
        "row_order": {"const": "north_to_south"},
        "world_projection": {"const": "EPSG:2154 metric XY; phase never resets per tile"},
        "variant_selection": {"const": "baked into the 72 profile IDs before packaging"},
        "runtime_procedural_material": {"const": "forbidden"},
        "runtime_orthophoto": {"const": "forbidden"},
        "surface_overlays": {"const": "not_packaged"}
      }
    },
    "qa_shader": {"type": "object"},
    "runtime_shader": {"$ref": "#/$defs/runtimeShader"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "required": ["path", "byte_count", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "byte_count": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "pngArtifact": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {"type": "object", "required": ["width", "height", "bit_depth", "colour_type"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "bit_depth": {"type": "integer"}, "colour_type": {"type": "integer"}}}
      ]
    },
    "fourPngArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basecolor", "normal", "height", "orm"],
      "properties": {"basecolor": {"$ref": "#/$defs/pngArtifact"}, "normal": {"$ref": "#/$defs/pngArtifact"}, "height": {"$ref": "#/$defs/pngArtifact"}, "orm": {"$ref": "#/$defs/pngArtifact"}}
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "id", "surface_basis", "atlas_slot", "atlas_uv", "physical_scale_m", "projection", "textures", "variant_selection", "runtime_modulation"],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 71},
        "id": {"type": "string", "minLength": 1},
        "surface_basis": {"const": "atlas_pbr"},
        "atlas_slot": {"type": "integer", "minimum": 0, "maximum": 71},
        "atlas_uv": {"$ref": "#/$defs/atlasUv"},
        "physical_scale_m": {"type": "number", "exclusiveMinimum": 0},
        "projection": {"enum": ["world_xy", "world_triplanar"]},
        "textures": {"$ref": "#/$defs/profileTextures"},
        "variant_selection": {"const": "baked_profile_id"},
        "runtime_modulation": {"const": "none"}
      }
    },
    "atlasUv": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "scale"],
      "properties": {
        "offset": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}},
        "scale": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}
      }
    },
    "profileTexture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byte_count", "sha256"],
      "properties": {
        "byte_count": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "profileTextures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basecolor", "normal", "height", "orm"],
      "properties": {
        "basecolor": {"$ref": "#/$defs/profileTexture"},
        "normal": {"$ref": "#/$defs/profileTexture"},
        "height": {"$ref": "#/$defs/profileTexture"},
        "orm": {"$ref": "#/$defs/profileTexture"}
      }
    },
    "runtimeShader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "status", "implementation", "source_artifact", "production_textured_runtime_qualified", "preview_surface_policy", "required_capabilities"],
      "properties": {
        "schema": {"const": "fireviewer.ground-runtime-shader-binding.v1"},
        "status": {"const": "pending_dedicated_mdl_validation"},
        "implementation": {"type": "null"},
        "source_artifact": {"type": "null"},
        "production_textured_runtime_qualified": {"const": false},
        "preview_surface_policy": {"const": "diagnostic_untextured_only"},
        "required_capabilities": {"const": ["four_profile_id_indirections", "rgba8_weighted_pbr_blend", "epsg2154_world_projection", "undirected_orientation_0_to_pi", "world_xy_and_world_triplanar"]}
      }
    }
  }
}
