{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fireviewer.fr/contracts/terrain/v1/tile-package.v3.schema.json",
  "title": "FireViewer canonical adaptive terrain tile package v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "tile_id", "recipe_id", "recipe_build_id", "crs", "bounds_l93_m", "normal_halo_sha256", "stitch_variants", "inputs", "ground_material", "surface_mapping", "outputs"],
  "properties": {
    "schema": {"const": "fireviewer.tile-package.v3"},
    "tile_id": {"type": "string", "minLength": 1},
    "recipe_id": {"$ref": "#/$defs/sha256"},
    "recipe_build_id": {"$ref": "#/$defs/sha256"},
    "crs": {"const": "EPSG:2154"},
    "bounds_l93_m": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
    "normal_halo_sha256": {"$ref": "#/$defs/sha256"},
    "stitch_variants": {"$ref": "tile-package.schema.json#/$defs/stitchCatalog"},
    "inputs": {
      "type": "object",
      "required": ["surface_correspondence"],
      "additionalProperties": {"$ref": "#/$defs/artifact"},
      "properties": {"surface_correspondence": {"allOf": [{"$ref": "#/$defs/artifact"}, {"properties": {"path": {"const": "surface-correspondence.json"}}}]}}
    },
    "ground_material": {"$ref": "#/$defs/groundMaterial"},
    "surface_mapping": {"$ref": "#/$defs/surfaceMapping"},
    "outputs": {"$ref": "#/$defs/canonicalOutputs"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byte_count", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "byte_count": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "groundMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "zone_path", "contract_sha256", "source_library_schema", "source_library_manifest_sha256", "source_library_identity_sha256", "source_library_content_sha256", "texture_contract_sha256", "runtime_atlas_sha256", "material_layer_sha256", "visual_acceptance", "runtime_shader"],
      "properties": {
        "schema": {"const": "fireviewer.ground-material-contract.v2"},
        "zone_path": {"type": "string", "minLength": 1},
        "contract_sha256": {"$ref": "#/$defs/sha256"},
        "source_library_schema": {"const": "fireviewer.clean-pbr-texture-library.v1"},
        "source_library_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "source_library_identity_sha256": {"$ref": "#/$defs/sha256"},
        "source_library_content_sha256": {"$ref": "#/$defs/sha256"},
        "texture_contract_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_atlas_sha256": {"type": "object", "additionalProperties": false, "required": ["basecolor", "normal", "height", "orm"], "properties": {"basecolor": {"$ref": "#/$defs/sha256"}, "normal": {"$ref": "#/$defs/sha256"}, "height": {"$ref": "#/$defs/sha256"}, "orm": {"$ref": "#/$defs/sha256"}}},
        "material_layer_sha256": {"$ref": "#/$defs/sha256"},
        "visual_acceptance": {"enum": ["pending_human_review", "accepted_human_visual"]},
        "runtime_shader": {"$ref": "ground-material-contract.v2.schema.json#/$defs/runtimeShader"}
      }
    },
    "surfaceMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "crs", "bounds_l93_m", "grid_size_px", "cell_size_m", "row_order", "profile_count", "profile_ids", "profile_weights", "confidence", "orientation", "world_projection", "variant_selection", "runtime_procedural_material", "runtime_orthophoto", "surface_overlays"],
      "properties": {
        "schema": {"const": "fireviewer.ground-surface-mapping.v3"},
        "crs": {"const": "EPSG:2154"},
        "bounds_l93_m": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
        "grid_size_px": {"const": [500, 500]}, "cell_size_m": {"const": 1}, "row_order": {"const": "north_to_south"}, "profile_count": {"const": 72},
        "profile_ids": {"$ref": "#/$defs/profileIdsMap"}, "profile_weights": {"$ref": "#/$defs/profileWeightsMap"}, "confidence": {"$ref": "#/$defs/confidenceMap"}, "orientation": {"$ref": "#/$defs/orientationMap"}, "world_projection": {"const": "EPSG:2154 metric XY with no tile-local phase reset"},
        "variant_selection": {"const": "baked_profile_id"}, "runtime_procedural_material": {"const": "forbidden"}, "runtime_orthophoto": {"const": "forbidden"}, "surface_overlays": {"const": "not_packaged"}
      }
    },
    "profileIdsMap": {"type": "object", "additionalProperties": false, "required": ["file", "mode", "encoding"], "properties": {"file": {"const": "ground-profile-ids.png"}, "mode": {"const": "RGBA8"}, "encoding": {"const": "four_zero_based_stable_profile_indices"}}},
    "profileWeightsMap": {"type": "object", "additionalProperties": false, "required": ["file", "mode", "encoding"], "properties": {"file": {"const": "ground-profile-weights.png"}, "mode": {"const": "RGBA8"}, "encoding": {"const": "four_profile_weights_sum_exactly_255_per_pixel"}}},
    "confidenceMap": {"type": "object", "additionalProperties": false, "required": ["file", "mode", "encoding"], "properties": {"file": {"const": "ground-confidence.png"}, "mode": {"const": "L8"}, "encoding": {"const": "best_vs_next_semantic_class_margin_0_to_255"}}},
    "orientationMap": {"type": "object", "additionalProperties": false, "required": ["file", "mode", "encoding"], "properties": {"file": {"const": "ground-orientation.png"}, "mode": {"const": "L8"}, "encoding": {"const": "undirected_angle_0_to_pi_mapped_to_uint8"}}},
    "canonicalOutputs": {
      "type": "object", "additionalProperties": false,
      "required": ["terrain_lod0", "terrain_lod1", "terrain_lod2", "hag_max_2m", "ground_profile_ids", "ground_profile_weights", "ground_confidence", "ground_orientation"],
      "properties": {"terrain_lod0": {"$ref": "#/$defs/artifact"}, "terrain_lod1": {"$ref": "#/$defs/artifact"}, "terrain_lod2": {"$ref": "#/$defs/artifact"}, "hag_max_2m": {"$ref": "#/$defs/artifact"}, "ground_profile_ids": {"$ref": "#/$defs/artifact"}, "ground_profile_weights": {"$ref": "#/$defs/artifact"}, "ground_confidence": {"$ref": "#/$defs/artifact"}, "ground_orientation": {"$ref": "#/$defs/artifact"}}
    }
  }
}
