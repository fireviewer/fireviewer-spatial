{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fireviewer.fr/contracts/terrain/v1/zone-spec.schema.json",
  "title": "FireViewer deterministic terrain zone specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "zone_id",
    "revision",
    "crs",
    "bounds_l93_m",
    "tile_size_m",
    "halo_m",
    "source_resolution_m",
    "dependencies",
    "dependency_artifacts",
    "source_requests",
    "workspace",
    "storage"
  ],
  "properties": {
    "schema": {"const": "fireviewer.zone-spec.v1"},
    "zone_id": {"$ref": "#/$defs/stableId"},
    "revision": {"$ref": "#/$defs/stableId"},
    "crs": {"const": "EPSG:2154"},
    "bounds_l93_m": {"$ref": "#/$defs/bounds"},
    "tile_size_m": {"const": 500},
    "halo_m": {"const": 10},
    "source_resolution_m": {"const": 2},
    "dependencies": {"$ref": "#/$defs/dependencies"},
    "dependency_artifacts": {"$ref": "#/$defs/dependencyArtifacts"},
    "source_requests": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sourceRecord"},
      "contains": {
        "type": "object",
        "required": ["product"],
        "properties": {"product": {"const": "orthophoto"}}
      },
      "minContains": 1,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["product"],
            "properties": {"product": {"const": "mnt"}}
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["product"],
            "properties": {"product": {"const": "mns"}}
          },
          "minContains": 1
        }
      ]
    },
    "pilot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regression_tile_id"],
      "properties": {
        "regression_tile_id": {"$ref": "#/$defs/stableId"}
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_root", "export_root"],
      "properties": {
        "work_root": {"type": "string", "minLength": 1},
        "export_root": {"type": "string", "minLength": 1}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimated_peak_bytes"],
      "properties": {
        "estimated_peak_bytes": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "bounds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"type": "number"}
    },
    "dependencies": {
      "type": "object",
      "required": [
        "algorithm",
        "clean_pbr_texture_library",
        "ground_texture_contract",
        "surface_correspondence_contract",
        "surface_correspondence_model",
        "surface_features",
        "terrain_quadtree_contract",
        "toolchain"
      ],
      "additionalProperties": false,
      "properties": {
        "algorithm": {"$ref": "#/$defs/sha256"},
        "clean_pbr_texture_library": {"$ref": "#/$defs/sha256"},
        "ground_texture_contract": {"$ref": "#/$defs/sha256"},
        "surface_correspondence_contract": {"$ref": "#/$defs/sha256"},
        "surface_correspondence_model": {"$ref": "#/$defs/sha256"},
        "surface_features": {"$ref": "#/$defs/sha256"},
        "terrain_quadtree_contract": {"$ref": "#/$defs/sha256"},
        "toolchain": {"$ref": "#/$defs/sha256"}
      }
    },
    "dependencyArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "dependencyArtifacts": {
      "type": "object",
      "required": [
        "algorithm",
        "clean_pbr_texture_library",
        "ground_texture_contract",
        "surface_correspondence_contract",
        "surface_correspondence_model",
        "surface_features",
        "terrain_quadtree_contract",
        "toolchain"
      ],
      "additionalProperties": false,
      "properties": {
        "algorithm": {"$ref": "#/$defs/dependencyArtifact"},
        "clean_pbr_texture_library": {"$ref": "#/$defs/dependencyArtifact"},
        "ground_texture_contract": {"$ref": "#/$defs/dependencyArtifact"},
        "surface_correspondence_contract": {"$ref": "#/$defs/dependencyArtifact"},
        "surface_correspondence_model": {"$ref": "#/$defs/dependencyArtifact"},
        "surface_features": {"$ref": "#/$defs/dependencyArtifact"},
        "terrain_quadtree_contract": {"$ref": "#/$defs/dependencyArtifact"},
        "toolchain": {"$ref": "#/$defs/dependencyArtifact"}
      }
    },
    "elevationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_url", "layer", "core_bounds_l93_m", "resolution_m"],
      "properties": {
        "service_url": {"type": "string", "pattern": "^(https|file):"},
        "layer": {"type": "string", "minLength": 1},
        "core_bounds_l93_m": {"$ref": "#/$defs/bounds"},
        "resolution_m": {"const": 2}
      }
    },
    "orthophotoWmsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_kind",
        "service_url",
        "layer",
        "core_bounds_l93_m",
        "resolution_m",
        "halo_m",
        "image_format",
        "maximum_download_bytes"
      ],
      "properties": {
        "service_kind": {"const": "wms"},
        "service_url": {"type": "string", "pattern": "^https:"},
        "layer": {"type": "string", "minLength": 1},
        "core_bounds_l93_m": {"$ref": "#/$defs/bounds"},
        "resolution_m": {"const": 1},
        "halo_m": {"const": 10},
        "image_format": {"enum": ["image/png", "image/jpeg"]},
        "maximum_download_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "wmtsMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrix_set",
        "matrix",
        "top_left_l93_m",
        "tile_width_px",
        "tile_height_px",
        "matrix_width",
        "matrix_height",
        "resolution_m"
      ],
      "properties": {
        "matrix_set": {"$ref": "#/$defs/stableId"},
        "matrix": {"$ref": "#/$defs/stableId"},
        "top_left_l93_m": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number", "multipleOf": 1}
        },
        "tile_width_px": {"type": "integer", "minimum": 1},
        "tile_height_px": {"type": "integer", "minimum": 1},
        "matrix_width": {"type": "integer", "minimum": 1},
        "matrix_height": {"type": "integer", "minimum": 1},
        "resolution_m": {"const": 1}
      }
    },
    "orthophotoWmtsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_kind",
        "service_url",
        "layer",
        "style",
        "core_bounds_l93_m",
        "resolution_m",
        "halo_m",
        "image_format",
        "maximum_download_bytes",
        "wmts_matrix"
      ],
      "properties": {
        "service_kind": {"const": "wmts"},
        "service_url": {"type": "string", "pattern": "^https:"},
        "layer": {"type": "string", "minLength": 1},
        "style": {"type": "string", "minLength": 1},
        "core_bounds_l93_m": {"$ref": "#/$defs/bounds"},
        "resolution_m": {"const": 1},
        "halo_m": {"const": 10},
        "image_format": {"enum": ["image/png", "image/jpeg"]},
        "maximum_download_bytes": {"type": "integer", "minimum": 1},
        "wmts_matrix": {"$ref": "#/$defs/wmtsMatrix"}
      }
    },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "product", "request", "license"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "product": {"enum": ["mnt", "mns", "orthophoto"]},
        "request": {
          "oneOf": [
            {"$ref": "#/$defs/elevationRequest"},
            {"$ref": "#/$defs/orthophotoWmsRequest"},
            {"$ref": "#/$defs/orthophotoWmtsRequest"}
          ]
        },
        "expected_sha256": {"$ref": "#/$defs/sha256"},
        "expected_byte_count": {"type": "integer", "minimum": 1},
        "source_revision_id": {"$ref": "#/$defs/stableId"},
        "license": {"type": "string", "minLength": 1},
        "pilot_score": {"type": "number"}
      },
      "allOf": [
        {
          "if": {"properties": {"product": {"const": "orthophoto"}}},
          "then": {
            "required": ["source_revision_id"],
            "properties": {
              "request": {
                "oneOf": [
                  {"$ref": "#/$defs/orthophotoWmsRequest"},
                  {"$ref": "#/$defs/orthophotoWmtsRequest"}
                ]
              }
            }
          },
          "else": {"properties": {"request": {"$ref": "#/$defs/elevationRequest"}}}
        },
        {
          "if": {
            "properties": {
              "request": {
                "properties": {"service_url": {"pattern": "^https:"}},
                "required": ["service_url"]
              }
            }
          },
          "then": {"required": ["source_revision_id"]},
          "else": {"required": ["expected_sha256", "expected_byte_count"]}
        },
        {
          "if": {"required": ["expected_sha256"]},
          "then": {"required": ["expected_byte_count"]}
        },
        {
          "if": {"required": ["expected_byte_count"]},
          "then": {"required": ["expected_sha256"]}
        }
      ]
    }
  }
}
