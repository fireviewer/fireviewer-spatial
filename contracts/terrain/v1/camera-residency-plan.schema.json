{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fireviewer.fr/contracts/terrain/v1/camera-residency-plan.schema.json",
  "title": "FireViewer camera residency plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "terrain_build_id", "selection", "camera_envelope_bindings", "entries"],
  "properties": {
    "schema": {"const": "fireviewer.camera-residency-plan.v1"},
    "terrain_build_id": {"$ref": "#/$defs/sha256"},
    "selection": {"const": "exact_convex_sat_aabb_frustum"},
    "camera_envelope_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/cameraEnvelopeBinding"}
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "minLength": 1},
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "cameraView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_id",
        "position_l93_ngf_m",
        "forward",
        "up",
        "vertical_fov_deg",
        "aspect_ratio",
        "near_clip_m",
        "far_clip_m"
      ],
      "properties": {
        "view_id": {"$ref": "#/$defs/id"},
        "position_l93_ngf_m": {"$ref": "#/$defs/vec3"},
        "forward": {"$ref": "#/$defs/vec3"},
        "up": {"$ref": "#/$defs/vec3"},
        "vertical_fov_deg": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 179},
        "aspect_ratio": {"type": "number", "exclusiveMinimum": 0},
        "near_clip_m": {"type": "number", "exclusiveMinimum": 0},
        "far_clip_m": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "cameraEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "camera_id", "mode", "views"],
      "properties": {
        "schema": {"const": "fireviewer.camera-envelope.v1"},
        "camera_id": {"$ref": "#/$defs/id"},
        "mode": {"enum": ["planned", "predicted", "interactive"]},
        "views": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/cameraView"}
        }
      }
    },
    "cameraEnvelopeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["camera_id", "sha256", "envelope"],
      "properties": {
        "camera_id": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "envelope": {"$ref": "#/$defs/cameraEnvelope"}
      }
    },
    "ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tile_id", "lod", "stitch_mask"],
      "properties": {
        "tile_id": {"type": "string", "minLength": 1},
        "lod": {"enum": [0, 1, 2]},
        "stitch_mask": {"type": "integer", "minimum": 0, "maximum": 15}
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_bytes", "gpu_bytes", "triangles"],
      "properties": {
        "cpu_bytes": {"type": "integer", "minimum": 0},
        "gpu_bytes": {"type": "integer", "minimum": 0},
        "triangles": {"type": "integer", "minimum": 0}
      }
    },
    "sets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible_lod0", "guard_lod0", "staging_lod0", "resident_lod1", "resident_lod2"],
      "properties": {
        "visible_lod0": {"$ref": "#/$defs/ids"},
        "guard_lod0": {"$ref": "#/$defs/ids"},
        "staging_lod0": {"$ref": "#/$defs/ids"},
        "resident_lod1": {"$ref": "#/$defs/ids"},
        "resident_lod2": {"$ref": "#/$defs/ids"}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories", "unreserved", "required_with_reserve", "reserve_fraction", "limits", "within_budget"],
      "properties": {
        "categories": {
          "type": "object",
          "additionalProperties": false,
          "required": ["active_lod0", "staging_lod0", "guard_lod0", "lod1", "lod2"],
          "properties": {
            "active_lod0": {"$ref": "#/$defs/cost"},
            "staging_lod0": {"$ref": "#/$defs/cost"},
            "guard_lod0": {"$ref": "#/$defs/cost"},
            "lod1": {"$ref": "#/$defs/cost"},
            "lod2": {"$ref": "#/$defs/cost"}
          }
        },
        "unreserved": {"$ref": "#/$defs/cost"},
        "required_with_reserve": {"$ref": "#/$defs/cost"},
        "reserve_fraction": {"type": "number", "minimum": 0.25, "exclusiveMaximum": 1},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu_bytes", "gpu_bytes", "maximum_triangles"],
          "properties": {
            "cpu_bytes": {"type": "integer", "minimum": 1},
            "gpu_bytes": {"type": "integer", "minimum": 1},
            "maximum_triangles": {"type": ["integer", "null"], "minimum": 1}
          }
        },
        "within_budget": {"const": true}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_camera_id", "staging_camera_id", "sets", "payloads", "budget"],
      "properties": {
        "active_camera_id": {"type": "string", "minLength": 1},
        "staging_camera_id": {"type": ["string", "null"]},
        "sets": {"$ref": "#/$defs/sets"},
        "payloads": {"type": "array", "items": {"$ref": "#/$defs/payload"}, "uniqueItems": true},
        "budget": {"$ref": "#/$defs/budget"}
      }
    }
  }
}
