{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fireviewer.fr/contracts/terrain/v1/zone-acceptance.schema.json",
  "title": "FireViewer accepted terrain zone receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "recipe_id",
    "recipe_build_id",
    "build_id",
    "source_merkle_root_sha256",
    "status",
    "tile_count",
    "seam_count",
    "qa_receipt",
    "qa_receipt_sha256",
    "visual_receipt",
    "visual_receipt_sha256",
    "runtime_shader",
    "usd_runtime_gate"
  ],
  "properties": {
    "schema": {"const": "fireviewer.zone.acceptance.v1"},
    "recipe_id": {"$ref": "#/$defs/sha256"},
    "recipe_build_id": {"$ref": "#/$defs/sha256"},
    "build_id": {"$ref": "#/$defs/sha256"},
    "source_merkle_root_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"const": "accepted"},
    "tile_count": {"type": "integer", "minimum": 1},
    "seam_count": {"type": "integer", "minimum": 0},
    "qa_receipt": {"const": "qa.receipt.v1.json"},
    "qa_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "visual_receipt": {"const": "zone-visual.accepted_blender_visual.v2.json"},
    "visual_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_shader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"const": "pending_dedicated_mdl_validation"}
      }
    },
    "usd_runtime_gate": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
