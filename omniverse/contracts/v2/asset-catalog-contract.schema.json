{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firewarning.fr/schemas/omniverse-asset-catalog.v2.json",
  "title": "FireViewer definitive Omniverse asset catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "catalog_id", "status", "expected_asset_count", "received_asset_count", "assets", "release_gates"],
  "properties": {
    "schema": {"const": "fireviewer.omniverse-asset-catalog.v2"},
    "catalog_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "status": {"enum": ["blocked_pending_usd_assets", "ready"]},
    "expected_asset_count": {"const": 295},
    "received_asset_count": {"type": "integer", "minimum": 0, "maximum": 295},
    "assets": {
      "type": "array",
      "maxItems": 295,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stable_id", "usd_path", "sha256", "status", "kit_open", "roles", "contexts", "placeholder"],
        "properties": {
          "stable_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
          "usd_path": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.usd(?:a|c|z)?$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "status": {"const": "accepted"},
          "kit_open": {"const": "passed"},
          "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "contexts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "placeholder": {"const": false}
        }
      }
    },
    "release_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_usd_received", "sha256_inventory", "isolated_kit_open", "license_and_provenance"],
      "properties": {
        "all_usd_received": {"enum": ["pending", "passed"]},
        "sha256_inventory": {"enum": ["pending", "passed"]},
        "isolated_kit_open": {"enum": ["pending", "passed"]},
        "license_and_provenance": {"enum": ["pending", "passed"]}
      }
    }
  }
}
