{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firewarning.fr/schemas/omniverse/perimeter-layer-contract.v1.json",
  "title": "FireViewer progressive perimeter layer contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_version",
    "contract_status",
    "layer_package",
    "base_map",
    "progression",
    "rendering",
    "content_boundary",
    "quality_gates",
    "release"
  ],
  "properties": {
    "schema": {"const": "fireviewer.omniverse-progressive-perimeter-layer-contract.v1"},
    "contract_version": {"const": 1},
    "contract_status": {"$ref": "#/$defs/contractStatus"},
    "layer_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer_package_id", "revision", "entry_layer", "entry_layer_sha256", "manifest_sha256"],
      "properties": {
        "layer_package_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$"},
        "revision": {"type": "integer", "minimum": 1},
        "entry_layer": {"$ref": "#/$defs/relativePath"},
        "entry_layer_sha256": {"$ref": "#/$defs/nullableSha256"},
        "manifest_sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "base_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_record",
        "contract_record_sha256",
        "package_id",
        "revision",
        "required_status",
        "acceptance_receipt_sha256"
      ],
      "properties": {
        "contract_record": {"$ref": "#/$defs/relativePath"},
        "contract_record_sha256": {"$ref": "#/$defs/sha256"},
        "package_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
        "revision": {"type": "integer", "minimum": 1},
        "required_status": {"const": "active"},
        "acceptance_receipt_sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "progression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_mode",
        "source_record",
        "source_sha256",
        "source_crs",
        "layer_crs",
        "geometry_role",
        "state_count",
        "first_local_date",
        "last_local_date",
        "ordered",
        "append_only",
        "state_records"
      ],
      "properties": {
        "production_mode": {"const": "progressive_separate_layer_revisions"},
        "source_record": {"$ref": "#/$defs/relativePath"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "source_crs": {"enum": ["EPSG:4326", "EPSG:2154"]},
        "layer_crs": {"const": "EPSG:2154"},
        "geometry_role": {"const": "cumulative_fire_perimeter"},
        "state_count": {"type": "integer", "minimum": 1},
        "first_local_date": {"type": "string", "format": "date"},
        "last_local_date": {"type": "string", "format": "date"},
        "ordered": {"const": true},
        "append_only": {"const": true},
        "state_records": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/perimeterState"}
        }
      }
    },
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composition_mode",
        "visualization_only",
        "timeline_mode",
        "seconds_per_day",
        "trace_enabled",
        "fill_enabled",
        "color_policy",
        "trace_width_m",
        "fill_opacity",
        "terrain_offset_m",
        "legend_required"
      ],
      "properties": {
        "composition_mode": {"const": "optional_sublayer_over_base_map"},
        "visualization_only": {"const": true},
        "timeline_mode": {"const": "timestamp_selects_single_perimeter_layer"},
        "seconds_per_day": {"const": 60.0},
        "trace_enabled": {"const": true},
        "fill_enabled": {"const": true},
        "color_policy": {"const": "chronological_palette"},
        "trace_width_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 20},
        "fill_opacity": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.6},
        "terrain_offset_m": {"type": "number", "minimum": 0.05, "maximum": 5.0},
        "legend_required": {"const": true}
      }
    },
    "content_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "embedded_in_map_upload",
        "simulation_enabled",
        "camera_rig_present",
        "flow_present",
        "flames_present",
        "smoke_present",
        "tree_destruction_present",
        "capture_present"
      ],
      "properties": {
        "embedded_in_map_upload": {"const": false},
        "simulation_enabled": {"const": false},
        "camera_rig_present": {"const": false},
        "flow_present": {"const": false},
        "flames_present": {"const": false},
        "smoke_present": {"const": false},
        "tree_destruction_present": {"const": false},
        "capture_present": {"const": false}
      }
    },
    "quality_gates": {"$ref": "#/$defs/perimeterQualityGates"},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_visual_decision",
        "acceptance_receipt_sha256",
        "layer_attachment_allowed",
        "automatic_map_mutation",
        "automatic_publication"
      ],
      "properties": {
        "human_visual_decision": {"enum": ["pending", "accepted", "rejected"]},
        "acceptance_receipt_sha256": {"$ref": "#/$defs/nullableSha256"},
        "layer_attachment_allowed": {"type": "boolean"},
        "automatic_map_mutation": {"const": false},
        "automatic_publication": {"const": false}
      }
    }
  },
  "$defs": {
    "contractStatus": {"enum": ["candidate_pending_die_visual_acceptance", "active", "deprecated"]},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\r\\n]+$"
    },
    "perimeterState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "append_order",
        "state_id",
        "layer_revision_id",
        "local_date",
        "valid_at",
        "source_selector",
        "geometry_type",
        "layer_path",
        "layer_sha256"
      ],
      "properties": {
        "append_order": {"type": "integer", "minimum": 1},
        "state_id": {"type": "string", "pattern": "^perimeter_[0-9]{3}$"},
        "layer_revision_id": {"type": "string", "minLength": 3},
        "local_date": {"type": "string", "format": "date"},
        "valid_at": {"type": "string", "format": "date-time"},
        "source_selector": {"type": "string", "pattern": "^#/"},
        "geometry_type": {"enum": ["Polygon", "MultiPolygon"]},
        "layer_path": {"$ref": "#/$defs/relativePath"},
        "layer_sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "gate": {"enum": ["not_run", "pending", "passed", "failed"]},
    "perimeterQualityGates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_map_active",
        "source_integrity",
        "geometry_validation",
        "crs_projection",
        "progression_order",
        "usd_validation",
        "trace_and_color_render",
        "human_visual_review"
      ],
      "properties": {
        "base_map_active": {"$ref": "#/$defs/gate"},
        "source_integrity": {"$ref": "#/$defs/gate"},
        "geometry_validation": {"$ref": "#/$defs/gate"},
        "crs_projection": {"$ref": "#/$defs/gate"},
        "progression_order": {"$ref": "#/$defs/gate"},
        "usd_validation": {"$ref": "#/$defs/gate"},
        "trace_and_color_render": {"$ref": "#/$defs/gate"},
        "human_visual_review": {"$ref": "#/$defs/gate"}
      }
    }
  }
}
