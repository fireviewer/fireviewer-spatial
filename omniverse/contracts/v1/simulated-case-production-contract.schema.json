{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firewarning.fr/schemas/omniverse/simulated-case-production-contract.v1.json",
  "title": "FireViewer Omniverse simulated case production contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_version",
    "contract_status",
    "case",
    "base_map",
    "perimeter_layers",
    "truth_scope",
    "timeline",
    "fire_behavior",
    "view_plan",
    "observation_contract",
    "dataset",
    "quality_gates",
    "release"
  ],
  "properties": {
    "schema": {"const": "fireviewer.omniverse-simulated-case-production-contract.v1"},
    "contract_version": {"const": 1},
    "contract_status": {"$ref": "#/$defs/contractStatus"},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "package_id",
        "incident_id",
        "scenario_id",
        "seed",
        "production_profile",
        "entry_stage",
        "entry_stage_sha256"
      ],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$"},
        "package_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$"},
        "incident_id": {"type": "string", "minLength": 3},
        "scenario_id": {"type": "string", "minLength": 3},
        "seed": {"type": "integer", "minimum": 0},
        "production_profile": {
          "enum": ["retrospective_daily_replay_v1", "synthetic_training_18d_v1"]
        },
        "entry_stage": {"$ref": "#/$defs/relativePath"},
        "entry_stage_sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "base_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_schema",
        "contract_record",
        "contract_record_sha256",
        "package_id",
        "revision",
        "artifact_manifest_sha256",
        "required_status",
        "acceptance_receipt_sha256"
      ],
      "properties": {
        "contract_schema": {"const": "fireviewer.omniverse-map-upload-contract.v1"},
        "contract_record": {"$ref": "#/$defs/relativePath"},
        "contract_record_sha256": {"$ref": "#/$defs/sha256"},
        "package_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
        "revision": {"type": "integer", "minimum": 1},
        "artifact_manifest_sha256": {"$ref": "#/$defs/nullableSha256"},
        "required_status": {"const": "active"},
        "acceptance_receipt_sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "perimeter_layers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_schema",
        "contract_record",
        "contract_record_sha256",
        "layer_package_id",
        "revision",
        "required_status",
        "acceptance_receipt_sha256",
        "composition_mode"
      ],
      "properties": {
        "contract_schema": {"const": "fireviewer.omniverse-progressive-perimeter-layer-contract.v1"},
        "contract_record": {"$ref": "#/$defs/relativePath"},
        "contract_record_sha256": {"$ref": "#/$defs/sha256"},
        "layer_package_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$"},
        "revision": {"type": "integer", "minimum": 1},
        "required_status": {"const": "active"},
        "acceptance_receipt_sha256": {"$ref": "#/$defs/nullableSha256"},
        "composition_mode": {"const": "separate_sublayer_reference"}
      }
    },
    "truth_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_record", "source_sha256", "geometry_origin", "notice"],
      "properties": {
        "kind": {"enum": ["retrospective_replay", "deterministic_synthetic"]},
        "source_record": {"$ref": "#/$defs/relativePath"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "geometry_origin": {"type": "string", "minLength": 3},
        "notice": {"type": "string", "minLength": 20}
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incident_days",
        "source_key_state_count",
        "states_per_day",
        "capture_state_count",
        "out_of_scene_state_count",
        "first_local_date",
        "last_local_date",
        "seconds_per_day",
        "state_transition",
        "active_outside_scene_policy"
      ],
      "properties": {
        "incident_days": {"type": "integer", "minimum": 1},
        "source_key_state_count": {"type": "integer", "minimum": 1},
        "states_per_day": {"type": "integer", "minimum": 1},
        "capture_state_count": {"type": "integer", "minimum": 1},
        "out_of_scene_state_count": {"type": "integer", "minimum": 0},
        "first_local_date": {"type": "string", "format": "date"},
        "last_local_date": {"type": "string", "format": "date"},
        "seconds_per_day": {"const": 60.0},
        "state_transition": {"enum": ["stepped_daily_hold", "deterministic_interpolated"]},
        "active_outside_scene_policy": {"const": "negative_state_without_fabricated_in_scene_fire"}
      }
    },
    "fire_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truth_visual_separation",
        "flow_required",
        "flame_visual_profile",
        "smoke_visual_profile",
        "smoke_minimum_vertical_lift_m",
        "tree_destruction",
        "burned_ground_replacement",
        "burned_area_monotonic",
        "burned_tree_count_monotonic",
        "active_front_changes_between_states"
      ],
      "properties": {
        "truth_visual_separation": {"const": true},
        "flow_required": {"const": true},
        "flame_visual_profile": {"const": "volumetric_turbulent_multiscale_non_primitive"},
        "smoke_visual_profile": {"const": "buoyant_rising_plume_non_primitive"},
        "smoke_minimum_vertical_lift_m": {"type": "number", "minimum": 1.6},
        "tree_destruction": {"const": "hide_exact_base_instancer_ids_inside_monotonic_burned_perimeter"},
        "burned_ground_replacement": {"const": true},
        "burned_area_monotonic": {"const": true},
        "burned_tree_count_monotonic": {"const": true},
        "active_front_changes_between_states": {"const": true}
      }
    },
    "view_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["camera_pool", "selection", "retargeting", "capture"],
      "properties": {
        "camera_pool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total_count", "human_count", "aerial_count", "thermal_aerial_count"],
          "properties": {
            "total_count": {"type": "integer", "minimum": 62},
            "human_count": {"type": "integer", "minimum": 55},
            "aerial_count": {"type": "integer", "minimum": 7},
            "thermal_aerial_count": {"type": "integer", "minimum": 7}
          }
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "seeded", "without_replacement_per_state", "framing_mix", "negative_views_required"],
          "properties": {
            "method": {"const": "deterministic_seeded_random"},
            "seeded": {"const": true},
            "without_replacement_per_state": {"const": true},
            "framing_mix": {
              "type": "array",
              "uniqueItems": true,
              "minItems": 2,
              "items": {"enum": ["smartphone_context", "professional_standard", "aerial_rgb_thermal"]}
            },
            "negative_views_required": {"const": true}
          }
        },
        "retargeting": {
          "type": "object",
          "additionalProperties": false,
          "required": ["positive_target", "line_of_sight_required", "per_capture", "negative_policy"],
          "properties": {
            "positive_target": {"const": "nearest_visible_flame_point_to_camera"},
            "line_of_sight_required": {"const": true},
            "per_capture": {"const": true},
            "negative_policy": {"const": "preserve_negative_context_without_fire_retarget"}
          }
        },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "views_per_state",
            "positive_views_per_state",
            "negative_views_per_state",
            "zooms_per_view",
            "aerial_thermal_required",
            "aerial_maximum_target_distance_m"
          ],
          "properties": {
            "views_per_state": {"const": 20},
            "positive_views_per_state": {"const": 16},
            "negative_views_per_state": {"const": 4},
            "zooms_per_view": {"const": 5},
            "aerial_thermal_required": {"const": true},
            "aerial_maximum_target_distance_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000}
          }
        }
      }
    },
    "observation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modalities", "metadata_fields", "canonical_key_fields", "atomic_write", "sha256_inventory"],
      "properties": {
        "modalities": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2}
        },
        "metadata_fields": {
          "type": "array",
          "minItems": 20,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2}
        },
        "canonical_key_fields": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2}
        },
        "atomic_write": {"const": true},
        "sha256_inventory": {"const": true}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_viewpoint_plans",
        "expected_capture_cases",
        "expected_positive_cases",
        "expected_negative_cases",
        "split_group_keys",
        "keep_all_zooms_together",
        "keep_incident_states_together",
        "invalid_observation_policy"
      ],
      "properties": {
        "expected_viewpoint_plans": {"type": "integer", "minimum": 1},
        "expected_capture_cases": {"type": "integer", "minimum": 1},
        "expected_positive_cases": {"type": "integer", "minimum": 1},
        "expected_negative_cases": {"type": "integer", "minimum": 1},
        "split_group_keys": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2}
        },
        "keep_all_zooms_together": {"const": true},
        "keep_incident_states_together": {"const": true},
        "invalid_observation_policy": {"const": "quarantine_not_training"}
      }
    },
    "quality_gates": {"$ref": "#/$defs/caseQualityGates"},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_visual_decision",
        "acceptance_receipt_sha256",
        "simulation_use_allowed",
        "pilot_capture_allowed",
        "full_dataset_capture_allowed",
        "dataset_release_allowed",
        "training_use_allowed",
        "automatic_publication",
        "site_publication_triggered"
      ],
      "properties": {
        "human_visual_decision": {"enum": ["pending", "accepted", "rejected"]},
        "acceptance_receipt_sha256": {"$ref": "#/$defs/nullableSha256"},
        "simulation_use_allowed": {"type": "boolean"},
        "pilot_capture_allowed": {"type": "boolean"},
        "full_dataset_capture_allowed": {"type": "boolean"},
        "dataset_release_allowed": {"type": "boolean"},
        "training_use_allowed": {"type": "boolean"},
        "automatic_publication": {"const": false},
        "site_publication_triggered": {"const": false}
      }
    }
  },
  "$defs": {
    "contractStatus": {"enum": ["candidate_pending_die_visual_acceptance", "active", "deprecated"]},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\r\\n]+$"
    },
    "gate": {"enum": ["not_run", "pending", "passed", "failed"]},
    "caseQualityGates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_map_active",
        "perimeter_layer_active",
        "source_integrity",
        "timeline_validation",
        "usd_validation",
        "tree_destruction",
        "flow_runtime_no_capture",
        "camera_retargeting",
        "metadata_completeness",
        "split_leakage",
        "human_visual_review",
        "capture_validation",
        "training_readiness"
      ],
      "properties": {
        "base_map_active": {"$ref": "#/$defs/gate"},
        "perimeter_layer_active": {"$ref": "#/$defs/gate"},
        "source_integrity": {"$ref": "#/$defs/gate"},
        "timeline_validation": {"$ref": "#/$defs/gate"},
        "usd_validation": {"$ref": "#/$defs/gate"},
        "tree_destruction": {"$ref": "#/$defs/gate"},
        "flow_runtime_no_capture": {"$ref": "#/$defs/gate"},
        "camera_retargeting": {"$ref": "#/$defs/gate"},
        "metadata_completeness": {"$ref": "#/$defs/gate"},
        "split_leakage": {"$ref": "#/$defs/gate"},
        "human_visual_review": {"$ref": "#/$defs/gate"},
        "capture_validation": {"$ref": "#/$defs/gate"},
        "training_readiness": {"$ref": "#/$defs/gate"}
      }
    }
  }
}
