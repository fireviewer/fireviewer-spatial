aws_region  = "eu-west-3"
aws_profile = "unicorn-whodev"

# Optional. Terraform creates the budget without email notifications when null.
budget_alert_email = null
monthly_budget_usd = 10

instance_type               = "m7i-flex.large"
scratch_volume_size_gib     = 100
scratch_iops                = 3000
scratch_throughput_mibps    = 125

# The direct EC2 G2/G3 receipt passed on 2026-08-21. Batch still requires an
# explicit opt-in so a normal foundation apply cannot create worker capacity.
g2_validated = false
enable_batch = false

# If the account already owns this OIDC provider, pass its ARN instead of
# asking this stack to create a duplicate. The ARN and repository name are not
# secrets.
github_repository         = "fireviewer/fireviewer-spatial"
github_oidc_provider_arn  = null

# Batch executes only the immutable image digest produced by the validated
# local build and smoke-test release path.
batch_image_digest = "sha256:3c3aef7fd7a0439971f0952cf65a8b2fdae67300f1526dcba4809d2816f88b37"

# Required only when Batch and the admin backend are activated. Use the exact
# path segment from the Vercel team URL; it is not the internal team ID.
vercel_team_slug          = null
vercel_project_name       = "fireviewer-api"
vercel_oidc_provider_arn  = null
